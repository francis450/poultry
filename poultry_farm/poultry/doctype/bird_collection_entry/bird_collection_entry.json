   "description": "Auto-calculated from crop placement date",
   "idx": 4
  },
  {
   "fieldname": "collection_details",
   "fieldtype": "Table",
   "label": "Collection by Weight Band",
   "options": "Bird Collection Detail",
   "reqd": 1,
   "idx": 5
  },
  {
   "fieldname": "section_summary",
   "fieldtype": "Section Break",
   "label": "Summary",
   "idx": 6
