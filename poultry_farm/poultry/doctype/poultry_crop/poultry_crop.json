   "idx": 26
  },
  {
   "fieldname": "last_recorded_weight_gms",
   "fieldtype": "Float",
   "label": "Last Recorded Weight (GMS)",
   "read_only": 1,
   "idx": 27
  },
  {
   "fieldname": "section_closure",
   "fieldtype": "Section Break",
   "label": "Closure",
   "idx": 28
  },
  {
   "fieldname": "expected_slaughter_date",
   "fieldtype": "Date",
   "label": "Expected Slaughter Date",
   "idx": 29
  },
  {
   "fieldname": "actual_slaughter_date",
   "fieldtype": "Date",
   "label": "Actual Slaughter Date",
   "read_only": 1,
   "idx": 30
  },
  {
   "fieldname": "col_break_5",
   "fieldtype": "Column Break",
   "idx": 31
  },
  {
   "fieldname": "total_birds_collected",
   "fieldtype": "Int",
   "label": "Total Birds Collected",
   "read_only": 1,
   "idx": 32
  },
  {
   "fieldname": "total_revenue",
   "fieldtype": "Currency",
   "label": "Total Revenue (KES)",
   "options": "KES",
   "read_only": 1,
   "idx": 33
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks",
   "idx": 34
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
