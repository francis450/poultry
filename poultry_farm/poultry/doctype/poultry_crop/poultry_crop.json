   "idx": 1
  },
  {
   "fieldname": "crop_number",
   "fieldtype": "Int",
   "label": "Crop Number",
   "reqd": 1,
   "description": "Sequential crop number for this farm e.g. 14",
   "idx": 2
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break",
   "idx": 3
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nSlaughter\nClosed",
   "default": "Draft",
   "reqd": 1,
   "in_list_view": 1,
   "idx": 4
  },
  {
   "fieldname": "section_farm",
   "fieldtype": "Section Break",
   "label": "Farm Details",
   "idx": 5
  },
  {
   "fieldname": "farm_name",
   "fieldtype": "Data",
   "label": "Farm Name",
   "reqd": 1,
   "description": "e.g. Paul Farm or Belmonte",
   "in_list_view": 1,
   "idx": 6
  },
  {
   "fieldname": "farm_code",
   "fieldtype": "Data",
   "label": "Farm Code",
   "reqd": 1,
   "description": "Short code used in naming e.g. PAUL",
   "idx": 7
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break",
   "idx": 8
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Farm Warehouse",
   "options": "Warehouse",
   "description": "Warehouse where feed and consumables for this crop are stored",
   "idx": 9
  },
  {
   "fieldname": "contract_farmer",
   "fieldtype": "Data",
   "label": "Contract Farmer",
   "description": "The farmer running this crop under contract",
   "idx": 10
  },
  {
   "fieldname": "section_chick",
   "fieldtype": "Section Break",
   "label": "Chick Details",
   "idx": 11
  },
  {
   "fieldname": "placement_date",
   "fieldtype": "Date",
   "label": "Placement Date",
   "reqd": 1,
   "description": "Date chicks were received. Day 1 of the crop.",
   "idx": 12
  },
  {
   "fieldname": "chicks_received",
   "fieldtype": "Int",
   "label": "Chicks Received",
   "reqd": 1,
   "idx": 13
  },
  {
   "fieldname": "birds_dead_on_arrival",
   "fieldtype": "Int",
   "label": "Birds Dead on Arrival",
   "default": "0",
   "description": "Dead in the box / transport mortality on placement day",
   "idx": 14
  },
  {
   "fieldname": "adjusted_opening_stock",
   "fieldtype": "Int",
   "label": "Adjusted Opening Stock",
   "read_only": 1,
   "description": "Chicks Received − Dead on Arrival",
   "idx": 15
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break",
   "idx": 16
  },
  {
   "fieldname": "chick_supplier",
   "fieldtype": "Data",
