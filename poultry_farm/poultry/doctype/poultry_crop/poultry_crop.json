{
 "name": "Poultry Crop",
 "doctype": "DocType",
 "module": "Poultry",
 "naming_rule": "Expression",
 "autoname": "format:CROP-{farm_code}-{placement_date}-{####}",
 "title_field": "crop_title",
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": [
  "crop_title",
  "crop_number",
  "col_break_1",
  "status",
  "section_farm",
  "farm_name",
  "farm_code",
  "col_break_2",
  "warehouse",
  "contract_farmer",
  "section_chick",
  "placement_date",
  "chicks_received",
  "birds_dead_on_arrival",
  "adjusted_opening_stock",
  "col_break_3",
  "chick_supplier",
  "chick_cost_per_unit",
  "total_chick_cost",
  "section_targets",
  "current_stock",
  "total_mortality",
  "mortality_pct",
  "col_break_4",
  "total_feed_consumed_kg",
  "fcr",
  "last_recorded_weight_gms",
  "section_closure",
  "expected_slaughter_date",
  "actual_slaughter_date",
  "col_break_5",
  "total_birds_collected",
  "total_revenue",
